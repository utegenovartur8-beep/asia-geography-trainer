{
  "name": "asia-geography-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "verify:data": "python3 scripts/verify_data.py",
    "generate:map": "node scripts/generate-map.mjs",
    "prebuild": "npm run generate:map",
    "format": "prettier --write src tests scripts/generate-map.mjs *.ts *.js *.json *.html README.md source/AUDIT.md",
    "build:portable": "npm run generate:map && tsc -b && vite build --config vite.portable.config.ts && node scripts/export-portable.mjs",
    "test:portable": "playwright test --config playwright.portable.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.5",
    "d3-geo": "3.1.1",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "9.22.0",
    "@playwright/test": "1.51.1",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.22.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "fflate": "0.8.2",
    "globals": "16.0.0",
    "prettier": "^3.5.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.26.0",
    "vite": "6.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.0.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
